rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the resource belongs to the current user
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if the user is an admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Dedicated restricted admins collection (manageable only via Admin SDK / Console)
    match /admins/{adminId} {
      allow read: if isAuthenticated() && (request.auth.uid == adminId || isAdmin());
      allow write: if false;
    }

    // Users collection and subcollections (watchlist, history)
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && (request.resource.data.get('role', 'user') == 'user' || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || isAdmin());
      allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());

      match /watchlist/{mediaId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      match /movies/{movieId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      match /shows/{showId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }

      match /history/{historyId} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // App configuration & version info (read-only for all clients)
    match /app_config/{configId} {
      allow read: if true;
    }

    // Feedbacks & feature requests collection (accessible to authenticated users only)
    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       request.resource.data.status == 'open' &&
                       request.resource.data.get('officialResponse', null) == null &&
                       request.resource.data.votes == 1 &&
                       request.resource.data.upvotedUserIds == [request.auth.uid] &&
                       request.resource.data.title is string &&
                       request.resource.data.title.size() > 0 &&
                       request.resource.data.title.size() <= 200 &&
                       request.resource.data.description is string &&
                       request.resource.data.description.size() > 0 &&
                       request.resource.data.description.size() <= 5000 &&
                       request.resource.data.get('media', []).size() <= 10 &&
                       request.resource.data.get('comments', []).size() == 0 &&
                       request.resource.data.get('commentCount', 0) == 0;

      // Allow vote updates with strict validation
      function isValidVoteUpdate() {
        let diff = request.resource.data.diff(resource.data);
        let affected = diff.affectedKeys();
        let voteDelta = request.resource.data.votes - resource.data.votes;
        let listDelta = request.resource.data.upvotedUserIds.size() - resource.data.upvotedUserIds.size();
        let creatorId = resource.data.userId;
        let creatorUpvotePreserved = !(creatorId in resource.data.upvotedUserIds) ||
                                     (creatorId in request.resource.data.upvotedUserIds);
        let uid = request.auth.uid;
        let isVoteAdd = voteDelta == 1 && listDelta == 1 &&
                        !(uid in resource.data.upvotedUserIds) &&
                        (uid in request.resource.data.upvotedUserIds) &&
                        request.resource.data.upvotedUserIds.hasAll(resource.data.upvotedUserIds);
        let isVoteRemove = voteDelta == -1 && listDelta == -1 &&
                           (uid in resource.data.upvotedUserIds) &&
                           !(uid in request.resource.data.upvotedUserIds) &&
                           resource.data.upvotedUserIds.hasAll(request.resource.data.upvotedUserIds);

        return isAuthenticated() &&
               affected.hasOnly(['votes', 'upvotedUserIds']) &&
               creatorUpvotePreserved &&
               (isVoteAdd || isVoteRemove) &&
               request.resource.data.votes >= 0;
      }

      // Allow atomic commentCount increment/decrement by signed-in users
      function isValidCommentCountUpdate() {
        let diff = request.resource.data.diff(resource.data);
        let countDelta = request.resource.data.get('commentCount', 0) - resource.data.get('commentCount', 0);
        return isAuthenticated() &&
               diff.affectedKeys().hasOnly(['commentCount']) &&
               (countDelta == 1 || countDelta == -1) &&
               request.resource.data.commentCount >= 0;
      }

      // Allow creator to safely edit content fields only (status, officialResponse, votes, and author identity are strictly locked)
      function isOwnerContentUpdate() {
        let diff = request.resource.data.diff(resource.data);
        return isAuthenticated() &&
               resource.data.userId == request.auth.uid &&
               diff.affectedKeys().hasOnly(['title', 'description', 'severity']) &&
               request.resource.data.title is string &&
               request.resource.data.title.size() > 0 &&
               request.resource.data.title.size() <= 200 &&
               request.resource.data.description is string &&
               request.resource.data.description.size() > 0 &&
               request.resource.data.description.size() <= 5000;
      }

      allow update: if isValidVoteUpdate() ||
                       isValidCommentCountUpdate() ||
                       isOwnerContentUpdate() ||
                       isAdmin();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                         request.resource.data.userId == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() <= 2000 &&
                         (request.resource.data.text.size() > 0 || ('imageUrl' in request.resource.data && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() > 0)) &&
                         (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2000));
        allow update: if isAuthenticated() &&
                         (resource.data.userId == request.auth.uid || isAdmin()) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt']) &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 2000;
        allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }
  }
}
