rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Legacy feedback images are read-only; new uploads use Cloudinary
    match /feedbacks/{feedbackId}/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
